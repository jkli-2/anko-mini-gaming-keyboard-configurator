# Maintainer: jkli-2 <jkli-2 at users dot noreply dot github dot com>

pkgbase=anko-mini-gaming-keyboard-configurator-git
pkgname=(
  anko-mini-gaming-keyboard-configurator-git
  anko-mini-gaming-keyboard-configurator-daemon-git
)
pkgver=0.1.0.r2.gdee4680
pkgrel=1
pkgdesc='Linux configurator for the Anko Mini Gaming Keyboard 43721375'
arch=(x86_64)
url='https://github.com/jkli-2/anko-mini-gaming-keyboard-configurator'
license=(MIT)
makedepends=(cargo git gtk4 libadwaita hidapi)
source=("anko-keyboard::git+https://github.com/jkli-2/anko-mini-gaming-keyboard-configurator.git")
b2sums=(SKIP)

pkgver() {
  cd anko-keyboard
  printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd anko-keyboard
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  cd anko-keyboard
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR=target
  export RUSTUP_TOOLCHAIN=stable
  cargo build --release --frozen -p keyboardd -p keyboard-ui
}

check() {
  cd anko-keyboard
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR=target
  export RUSTUP_TOOLCHAIN=stable
  cargo test --workspace --frozen
}

package_anko-mini-gaming-keyboard-configurator-daemon-git() {
  pkgdesc='Native daemon companion for the Anko Mini Gaming Keyboard configurator'
  depends=(hidapi systemd-libs)
  provides=(anko-mini-gaming-keyboard-configurator-daemon)
  conflicts=(anko-mini-gaming-keyboard-configurator-daemon)

  cd anko-keyboard
  install -Dm0755 target/release/keyboardd \
    "$pkgdir/usr/libexec/anko-keyboard/keyboardd"
  install -Dm0644 packaging/native/io.github.jkli_2.anko_keyboard_configurator.Daemon.service \
    "$pkgdir/usr/lib/systemd/user/io.github.jkli_2.anko_keyboard_configurator.Daemon.service"
  install -Dm0644 packaging/native/io.github.jkli_2.anko_keyboard_configurator.Daemon.dbus.service \
    "$pkgdir/usr/share/dbus-1/services/io.github.jkli_2.anko_keyboard_configurator.Daemon.service"
  install -Dm0644 packaging/native/70-anko-keyboard.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-anko-keyboard.rules"
  install -Dm0644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_anko-mini-gaming-keyboard-configurator-git() {
  pkgdesc='GTK client for the Anko Mini Gaming Keyboard configurator'
  depends=(
    "anko-mini-gaming-keyboard-configurator-daemon-git=$pkgver-$pkgrel"
    gtk4
    libadwaita
  )
  provides=(anko-mini-gaming-keyboard-configurator)
  conflicts=(anko-mini-gaming-keyboard-configurator)

  cd anko-keyboard
  install -Dm0755 target/release/keyboard-ui \
    "$pkgdir/usr/bin/keyboard-ui"
  install -Dm0644 packaging/flatpak/io.github.jkli_2.anko_keyboard_configurator.desktop \
    "$pkgdir/usr/share/applications/io.github.jkli_2.anko_keyboard_configurator.desktop"
  install -Dm0644 packaging/flatpak/io.github.jkli_2.anko_keyboard_configurator.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.jkli_2.anko_keyboard_configurator.metainfo.xml"
  install -Dm0644 packaging/flatpak/io.github.jkli_2.anko_keyboard_configurator.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.jkli_2.anko_keyboard_configurator.svg"
  install -Dm0644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
